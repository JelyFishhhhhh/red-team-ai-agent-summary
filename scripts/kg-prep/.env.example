# Neo4j connection — copy to .env and fill in real values
# The .env file is gitignored (see repo root .gitignore).
#
# Aura Free:
#   URI format: neo4j+s://<instance-id>.databases.neo4j.io
#   USERNAME is the instance ID (NOT "neo4j" for Aura Free)
#
# Local / Docker Neo4j:
#   URI format: bolt://localhost:7687
#   USERNAME: neo4j

NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=<your-username>
NEO4J_PASSWORD=<your-password>

# Optional — only used by some Cypher tooling, not by our import script
# NEO4J_DATABASE=<your-instance-id>
